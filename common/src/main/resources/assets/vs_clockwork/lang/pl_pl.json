  "vs_clockwork.ponder.plane_tips.text_8": "Skrzydła niesymetryczne będą miały kąt 20",
  "vs_clockwork.ponder.plane_tips.text_9": "Powodując skręcanie samolotu",

  "vs_clockwork.ponder.duct.header": "Przewody gazowe",

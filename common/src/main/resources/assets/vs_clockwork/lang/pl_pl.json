  "vs_clockwork.ponder.alt_meter.header": "Wysokościomierz",
  "vs_clockwork.ponder.alt_meter.text_1": "Kliknij PPM na wysokościomierzu, aby ustawić docelową wysokość",
  "vs_clockwork.ponder.alt_meter.text_2": "Wysokościomierz wyśle sygnał redstone na tej wysokości,",
  "vs_clockwork.ponder.alt_meter.text_3": "A także po jej przekroczeniu",
  "vs_clockwork.ponder.alt_meter.text_4": "Możesz również ustawić czułość, czyli zakres, w którym zacznie emitować sygnał",
  "vs_clockwork.ponder.alt_meter.text_5": "Siła sygnału będzie rosnąć wraz ze zbliżaniem się do docelowej wysokości",
  "vs_clockwork.ponder.alt_meter.text_6": "Ustawienie kierunku pozwala wybrać, po której stronie docelowej wysokości będzie działać wysokościomierz",
  "vs_clockwork.ponder.alt_meter.text_7": "Możliwe ustawienia to: W GÓRĘ, W DÓŁ i OBA",
  "vs_clockwork.ponder.alt_meter.text_8": "W GÓRĘ sprawi, że wysokościomierz będzie działać tylko przy zbliżaniu się do docelowej wysokości od dołu",
  "vs_clockwork.ponder.alt_meter.text_9": "W DÓŁ będzie działać tylko przy zbliżaniu się do celu od góry",
  "vs_clockwork.ponder.alt_meter.text_10": "OBA będzie działać przy zbliżaniu się do docelowej wysokości zarówno od góry, jak i od dołu",
  "vs_clockwork.ponder.alt_meter.text_11": "Osiągnie maksymalną siłę sygnału równą 15 dokładnie w punkcie docelowym",

  "vs_clockwork.ponder.flap_bearing.header": "Łożysko lotki",
  "vs_clockwork.ponder.flap_bearing.text_1": "Łożyska lotek to wyjątkowy rodzaj łożysk",
  "vs_clockwork.ponder.flap_bearing.text_2": "Ale nadal wymagają kleju,",
  "vs_clockwork.ponder.flap_bearing.text_3": "za to nie zaczynają się od razu obracać po otrzymaniu obrotu",
  "vs_clockwork.ponder.flap_bearing.text_4": "Zamiast tego przechylają się po otrzymaniu sygnału redstone",
  "vs_clockwork.ponder.flap_bearing.text_5": "Analogowe siły sygnału pozwalają na dokładniejszą kontrolę kąta",

  "vs_clockwork.ponder.smart_flap_bearing.header": "Inteligentne łożysko lotki",
  "vs_clockwork.ponder.smart_flap_bearing.text_1": "Inteligentne łożyska lotek działają tak samo jak zwykłe",
  "vs_clockwork.ponder.smart_flap_bearing.text_2": "Z tą różnicą, że mają wbudowane gniazda łączy redstone",
  "vs_clockwork.ponder.smart_flap_bearing.text_3": "Co pozwala na dużo bardziej kompaktowe konstrukcje.",

  "vs_clockwork.ponder.gyro.header": "Żyroskop",
  "vs_clockwork.ponder.gyro.text_1": "Żyroskop ustabilizuje statek w jego kierunku",
  "vs_clockwork.ponder.gyro.text_2": "Sygnał redstone z każdej strony przechyli statek",

  "vs_clockwork.ponder.solid_delivery.header": "Dostawa przedmiotów",
  "vs_clockwork.ponder.solid_delivery.text_1": "Działa i zsypy dostawcze mogą transportować przedmioty na krótkim dystansie",
  "vs_clockwork.ponder.solid_delivery.text_2": "Mają gniazdo częstotliwości, podobne do łączy redstone",
  "vs_clockwork.ponder.solid_delivery.text_3": "Działa strzelają tylko do zsypów o tej samej częstotliwości",
  "vs_clockwork.ponder.solid_delivery.text_4": "Działa wystrzelą dowolne przedmioty z magazynu znajdującego się poniżej",
  "vs_clockwork.ponder.solid_delivery.text_5": "Zaletą dział dostawczych w porównaniu do np. wyrzutni odważnikowej,",
  "vs_clockwork.ponder.solid_delivery.text_6": "jest to, że działo dostawcze może strzelać między statkami.",
  "vs_clockwork.ponder.solid_delivery.text_7": "Zarówno działo, jak i zsyp można umieszczać tylko na Składnicach,",
  "vs_clockwork.ponder.solid_delivery.text_8": "Zsypach,",
  "vs_clockwork.ponder.solid_delivery.text_9": "i taśmach",


  "vs_clockwork.ponder.wings.header": "Skrzydła",
  "vs_clockwork.ponder.wings.text_1": "W Valkyrien Skies wszystkie bloki podlegają aerodynamice",
  "vs_clockwork.ponder.wings.text_2": "Kształt bloku może wpływać na jego zachowanie aerodynamiczne",
  "vs_clockwork.ponder.wings.text_3": "Oznacza to, że bloki takie jak płyty mogą zapewniać niewielką siłę nośną",
  "vs_clockwork.ponder.wings.text_4": "Oraz doświadczać mniejszego oporu podczas ruchu w powietrzu",
  "vs_clockwork.ponder.wings.text_5": "Bloki skrzydeł wzmacniają swój efekt aerodynamiczny",
  "vs_clockwork.ponder.wings.text_6": "Mają silniejszą siłę nośną i doświadczają mniejszego oporu",

  "vs_clockwork.ponder.cambered_wings.header": "Skrzydła niesymetryczne",
  "vs_clockwork.ponder.cambered_wings.text_1": "Zwykłe skrzydła mają bazowy kąt natarcia równy 0",
  "vs_clockwork.ponder.cambered_wings.text_2": "Oznacza to, że zachowują się tak samo, jak w prawdziwym życiu",
  "vs_clockwork.ponder.cambered_wings.text_3": "Zwykle skutkując przyjemnym szybowaniem",
  "vs_clockwork.ponder.cambered_wings.text_4": "Skrzydła niesymetryczne mają bazowy kąt natarcia równy 20",
  "vs_clockwork.ponder.cambered_wings.text_5": "Oznacza to, że zachowują się tak, jakby były przechylone o 20 stopni w górę",
  "vs_clockwork.ponder.cambered_wings.text_6": "Generując znacznie więcej siły nośnej niż zwykłe skrzydła",

  "vs_clockwork.ponder.plane_tips.header": "Wskazówki dotyczące samolotów",
  "vs_clockwork.ponder.plane_tips.text_1": "Wskazówka #1: przez większość czasu używaj zwykłych skrzydeł",
  "vs_clockwork.ponder.plane_tips.text_2": "Zwykłe skrzydła zapewniają wystarczającą siłę nośną dla większości samolotów",
  "vs_clockwork.ponder.plane_tips.text_3": "Użycie zbyt wielu skrzydeł niesymetrycznych może powodować nadmierne wykonywanie pętli",
  "vs_clockwork.ponder.plane_tips.text_4": "Wskazówka #2: Dodaj statecznik pionowy",
  "vs_clockwork.ponder.plane_tips.text_5": "Posiadanie statecznika pionowego może znacznie zwiększyć stabilność w powietrzu",

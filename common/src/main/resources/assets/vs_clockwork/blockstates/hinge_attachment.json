{
  "multipart": [
    { "when": {"facing": "up", "roll": "0"}, "apply": {"model": "vs_clockwork:block/hinge/attachment", "x": 0, "y": 0} },
    { "when": {"facing": "up", "roll": "1"}, "apply": {"model": "vs_clockwork:block/hinge/attachment_roll1", "x": 0, "y": 0} },
    { "when": {"facing": "up", "roll": "2"}, "apply": {"model": "vs_clockwork:block/hinge/attachment_roll2", "x": 0, "y": 0} },
    { "when": {"facing": "up", "roll": "3"}, "apply": {"model": "vs_clockwork:block/hinge/attachment_roll3", "x": 0, "y": 0} },
    { "when": {"facing": "down", "roll": "0"}, "apply": {"model": "vs_clockwork:block/hinge/attachment", "x": 180, "y": 0} },
    { "when": {"facing": "down", "roll": "1"}, "apply": {"model": "vs_clockwork:block/hinge/attachment_roll1", "x": 180, "y": 0} },
    { "when": {"facing": "down", "roll": "2"}, "apply": {"model": "vs_clockwork:block/hinge/attachment_roll2", "x": 180, "y": 0} },
    { "when": {"facing": "down", "roll": "3"}, "apply": {"model": "vs_clockwork:block/hinge/attachment_roll3", "x": 180, "y": 0} },
    { "when": {"facing": "north", "roll": "0"}, "apply": {"model": "vs_clockwork:block/hinge/attachment", "x": 90, "y": 0} },
    { "when": {"facing": "north", "roll": "1"}, "apply": {"model": "vs_clockwork:block/hinge/attachment_roll1", "x": 90, "y": 0} },
    { "when": {"facing": "north", "roll": "2"}, "apply": {"model": "vs_clockwork:block/hinge/attachment_roll2", "x": 90, "y": 0} },
    { "when": {"facing": "north", "roll": "3"}, "apply": {"model": "vs_clockwork:block/hinge/attachment_roll3", "x": 90, "y": 0} },
    { "when": {"facing": "east", "roll": "0"}, "apply": {"model": "vs_clockwork:block/hinge/attachment", "x": 90, "y": 90} },
    { "when": {"facing": "east", "roll": "1"}, "apply": {"model": "vs_clockwork:block/hinge/attachment_roll1", "x": 90, "y": 90} },
    { "when": {"facing": "east", "roll": "2"}, "apply": {"model": "vs_clockwork:block/hinge/attachment_roll2", "x": 90, "y": 90} },
    { "when": {"facing": "east", "roll": "3"}, "apply": {"model": "vs_clockwork:block/hinge/attachment_roll3", "x": 90, "y": 90} },
    { "when": {"facing": "south", "roll": "0"}, "apply": {"model": "vs_clockwork:block/hinge/attachment", "x": 90, "y": 180} },
    { "when": {"facing": "south", "roll": "1"}, "apply": {"model": "vs_clockwork:block/hinge/attachment_roll1", "x": 90, "y": 180} },
    { "when": {"facing": "south", "roll": "2"}, "apply": {"model": "vs_clockwork:block/hinge/attachment_roll2", "x": 90, "y": 180} },
    { "when": {"facing": "south", "roll": "3"}, "apply": {"model": "vs_clockwork:block/hinge/attachment_roll3", "x": 90, "y": 180} },
    { "when": {"facing": "west", "roll": "0"}, "apply": {"model": "vs_clockwork:block/hinge/attachment", "x": 90, "y": 270} },
    { "when": {"facing": "west", "roll": "1"}, "apply": {"model": "vs_clockwork:block/hinge/attachment_roll1", "x": 90, "y": 270} },
    { "when": {"facing": "west", "roll": "2"}, "apply": {"model": "vs_clockwork:block/hinge/attachment_roll2", "x": 90, "y": 270} },
    { "when": {"facing": "west", "roll": "3"}, "apply": {"model": "vs_clockwork:block/hinge/attachment_roll3", "x": 90, "y": 270} },
    {
      "when": { "OR": [
        {"facing": "up|down|north", "roll": "0", "seat": "positive"},
        {"facing": "up|down|north", "roll": "2", "seat": "negative"},
        {"facing": "south", "roll": "0", "seat": "negative"},
        {"facing": "south", "roll": "2", "seat": "positive"}
      ] },
      "apply": {"model": "vs_clockwork:block/hinge/pin", "y": 270}
    },
    {
      "when": { "OR": [
        {"facing": "up|down|north", "roll": "0", "seat": "negative"},
        {"facing": "up|down|north", "roll": "2", "seat": "positive"},
        {"facing": "south", "roll": "0", "seat": "positive"},
        {"facing": "south", "roll": "2", "seat": "negative"}
      ] },
      "apply": {"model": "vs_clockwork:block/hinge/pin", "y": 90}
    },
    {
      "when": { "OR": [
        {"facing": "up", "roll": "1", "seat": "positive"},
        {"facing": "up", "roll": "3", "seat": "negative"},
        {"facing": "down", "roll": "1", "seat": "negative"},
        {"facing": "down", "roll": "3", "seat": "positive"},
        {"facing": "east", "roll": "0", "seat": "negative"},
        {"facing": "east", "roll": "2", "seat": "positive"},
        {"facing": "west", "roll": "0", "seat": "positive"},
        {"facing": "west", "roll": "2", "seat": "negative"}
      ] },
      "apply": {"model": "vs_clockwork:block/hinge/pin", "y": 180}
    },
    {
      "when": { "OR": [
        {"facing": "up", "roll": "1", "seat": "negative"},
        {"facing": "up", "roll": "3", "seat": "positive"},
        {"facing": "down", "roll": "1", "seat": "positive"},
        {"facing": "down", "roll": "3", "seat": "negative"},
        {"facing": "east", "roll": "0", "seat": "positive"},
        {"facing": "east", "roll": "2", "seat": "negative"},
        {"facing": "west", "roll": "0", "seat": "negative"},
        {"facing": "west", "roll": "2", "seat": "positive"}
      ] },
      "apply": {"model": "vs_clockwork:block/hinge/pin"}
    },
    {
      "when": { "OR": [
        {"facing": "north|east|south|west", "roll": "1", "seat": "positive"},
        {"facing": "north|east|south|west", "roll": "3", "seat": "negative"}
      ] },
      "apply": {"model": "vs_clockwork:block/hinge/pin", "x": 270}
    },
    {
      "when": { "OR": [
        {"facing": "north|east|south|west", "roll": "1", "seat": "negative"},
        {"facing": "north|east|south|west", "roll": "3", "seat": "positive"}
      ] },
      "apply": {"model": "vs_clockwork:block/hinge/pin", "x": 90}
    }
  ]
}
